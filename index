<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>To-Do List Sincronizado</title>
<!-- Librería oficial de Supabase -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
  :root {
    --bar-bg: #88878C;
    --accent: #88878C;
    --bg-grid: rgba(136, 135, 140, 0.08);
    --text-main: #333;
    --scale: 1;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: transparent;
    font-family: 'Inter', sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    transform: scale(var(--scale));
    transform-origin: top center;
  }
  .widget-container {
    width: 380px;
    background: #fff;
    border: 1px solid #e0def4;
    border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    overflow: hidden;
    padding: 16px;
  }
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom: 1px solid #eee;
  }
  .input-area {
    display: flex;
    gap: 8px;
    margin: 12px 0;
  }
  input[type="text"] {
    flex: 1;
    padding: 8px 12px;
    border: 1px solid #ddd;
    border-radius: 8px;
    outline: none;
  }
  .add-btn {
    background: var(--accent);
    color: white;
    border: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    display: grid;
    place-items: center;
    font-size: 16px;
  }
  .task-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-height: 250px;
    overflow-y: auto;
  }
  .task-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid #f5f5f5;
  }
  .task-content {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
  }
  .checkbox {
    width: 18px;
    height: 18px;
    border: 2px solid var(--accent);
    border-radius: 4px;
    display: inline-block;
  }
  .task-item.completed .checkbox {
    background: var(--accent);
  }
  .task-item.completed span {
    text-decoration: line-through;
    color: #999;
  }
  .sync-status {
    font-size: 10px;
    color: #888;
    text-align: right;
    margin-top: 8px;
  }
</style>
</head>
<body>

<div class="widget-container">
  <div class="header">
    <h3 style="margin:0; color:var(--bar-bg);">Mis Tareas Sincronizadas</h3>
  </div>
  
  <div class="input-area">
    <input type="text" id="taskInput" placeholder="Añadir nueva tarea...">
    <button class="add-btn" id="addBtn">＋</button>
  </div>

  <ul class="task-list" id="taskList"></ul>
  
  <div class="sync-status" id="syncStatus">Conectando con Supabase...</div>
</div>

<script>
  // --- CONFIGURACIÓN DE SUPABASE ---
  const SUPABASE_URL = 'TU_SUPABASE_URL';
  const SUPABASE_ANON_KEY = 'TU_SUPABASE_ANON_KEY';

  const { createClient } = supabase;
  const _supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
  const WIDGET_ID = 'mi_todo_principal';

  let tasks = [];

  async function loadTasks() {
    try {
      let { data, error } = await _supabase
        .from('todo_widget')
        .select('*')
        .eq('id', WIDGET_ID)
        .single();

      if (data && data.content) {
        tasks = data.content;
        render();
        document.getElementById('syncStatus').textContent = '● Sincronizado en la nube';
      } else {
        document.getElementById('syncStatus').textContent = '● Sin tareas previas';
      }
    } catch (err) {
      console.error(err);
      document.getElementById('syncStatus').textContent = 'Error al conectar con Supabase';
    }
  }

  async function saveTasks() {
    document.getElementById('syncStatus').textContent = 'Sincronizando...';
    try {
      const { error } = await _supabase
        .from('todo_widget')
        .upsert({ id: WIDGET_ID, content: tasks });

      if (error) throw error;
      document.getElementById('syncStatus').textContent = '● Sincronizado en la nube';
    } catch (err) {
      console.error(err);
      document.getElementById('syncStatus').textContent = 'Error al guardar';
    }
  }

  function render() {
    const list = document.getElementById('taskList');
    list.innerHTML = '';
    tasks.forEach((task, index) => {
      const li = document.createElement('li');
      li.className = `task-item ${task.completed ? 'completed' : ''}`;
      li.innerHTML = `
        <div class="task-content" onclick="toggleTask(${index})">
          <div class="checkbox"></div>
          <span>${task.text}</span>
        </div>
        <button onclick="deleteTask(${index})" style="border:none;background:none;color:#ccc;cursor:pointer;">×</button>
      `;
      list.appendChild(li);
    });
  }

  window.toggleTask = function(index) {
    tasks[index].completed = !tasks[index].completed;
    render();
    saveTasks();
  }

  window.deleteTask = function(index) {
    tasks.splice(index, 1);
    render();
    saveTasks();
  }

  document.getElementById('addBtn').addEventListener('click', () => {
    const text = document.getElementById('taskInput').value.trim();
    if (!text) return;
    tasks.push({ text, completed: false });
    document.getElementById('taskInput').value = '';
    render();
    saveTasks();
  });

  document.getElementById('taskInput').addEventListener('keypress', (e) => {
    if (e.key === 'Enter') document.getElementById('addBtn').click();
  });

  // Cargar al iniciar
  loadTasks();
</script>

</body>
</html>
